%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Parameters
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% General Parameters
Nf = 11;                                                                    % Number of harmonics
fs = 16500;                                                                 % Sampling frequency (Hz)
fel = 60;                                                                   % Grid frequency (Hz)
Nt_max = 3600;                                                             % Limit max number of samples
th = 100;                                                                    % Threshold for load changes
ID = 5;                                                                     % ID selector for single device

% SNN Coding
T_sim = 50;                                                                 % Number of time steps per sample
max_rate = 100;                                                             % Max spike rate (Hz-like scale)
tau = 10;                                                                   % Membrane time constant
V_th = 2;                                                                   % Firing threshold
V_reset = 0;                                                                % Reset potential

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Load Data
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
load("C:\Users\schir\OneDrive\Studium\34_Github\SpikeNILM\data\redd3HF.mat")
time = squeeze(input(1001:Nt_max,1,1));
X = squeeze(input(1001:Nt_max,3:end,:));
y = squeeze(output(1001:Nt_max,3:end));
[Nt, M] = size(y);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Preprocess Data
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%===================================================
% General
%===================================================
I_ac = squeeze(X(:,:,2));
V_ac = squeeze(X(:,:,1));
Vrms = rms(V_ac')';
Irms = rms(I_ac')';
Pact = Vrms .* Irms;
Psum = sum(y, 2);

%===================================================
% FFT
%===================================================
% Current
I_f_ac = abs(fft(I_ac'))' / (fs/fel);
I_f_ac = 2*I_f_ac(:, 2:Nf+1);

% Voltage
V_f_ac = abs(fft(V_ac'))' / (fs/fel);
V_f_ac = 2*V_f_ac(:, 2:Nf+1);

%===================================================
% Load Changes
%===================================================
% Input
dI_f_ac = [zeros(1, Nf); abs(diff(I_f_ac))];
dV_f_ac = [zeros(1, Nf); abs(diff(V_f_ac))];

% Ouput
dydt = [zeros(1, M); diff(y)];
% s = abs(dydt)
s= dydt;
s(s < th) = 0;
s(s >=th) = 1;
s_agg = sum(s')';
s_agg(s_agg > 1) = 1;
s_id = s(:,ID);


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Calculation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%===================================================
% Encoding
%===================================================
% Normalize input
dI_norm = dI_f_ac ./ (th/max(Vrms) + 1e-12);

% Allocate spike tensor: [time, harmonics, samples]
spikes = zeros(T_sim, Nf, Nt);

for t = 1:Nt
    for f = 1:Nf
        rate = dI_norm(t,f) * max_rate;
        p_spike = rate / max_rate;  % probability per step

        % Generate Poisson spikes
        spikes(:,f,t) = rand(T_sim,1) < p_spike;
    end
end

%===================================================
% LIF Neuron
%===================================================
% Output storage
lif_out = zeros(Nt*T_sim,1);   
lif_mem = zeros(Nt*T_sim,1); 
lif_time = linspace(time(1), time(end), Nt*T_sim);

% Init
V = 0;  % continuous membrane
idx = 1;

% Calc
for t = 1:Nt
    for ts = 1:T_sim
        
        % Input current = sum over harmonics
        I_in = sum(spikes(ts,:,t));
        
        % LIF update (Euler)
        V = V + (-V + I_in) / tau;
        
        % Store membrane
        lif_mem(idx) = V;
        
        % Fire condition
        if V >= V_th
            lif_out(idx) = 1;
            V = V - V_th;   % soft reset (better than hard reset)
        else
            lif_out(idx) = 0;
        end
        
        idx = idx + 1;
    end
end

% Downsample spikes to cycle level for comparison
lif_out_cycle = reshape(lif_out, T_sim, Nt);
lif_out_cycle = sum(lif_out_cycle)' > 0;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Plotting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
figure;
subplot(4,1,1);
plot(time, Pact);
hold on
plot(time, Psum);
grid on;
legend(["P_{agg}", "P_{app}"]);
ylabel("Power (W)")
xticks([]);
title('Aggregated Power and Summed Node Power');

subplot(4,1,2);
imagesc(time, [], log(dI_f_ac)');
ylabel("Harmonic number (f/fel)")
xticks([]);
title('Input Current Harmonics');

subplot(4,1,3);
plot(lif_time, lif_mem);
hold on;
plot(lif_time, V_th*ones(size(lif_time)));
grid on;
ylabel("Voltage (V)")
xticks([]);
title('LIF Membrane Potential');

subplot(4,1,4);
plot(time, lif_out_cycle*2);
hold on;
plot(time, s_agg);
grid on
legend(["S_{pred}", "S_{true}"]);
ylabel("State (-)")
xlabel("time (sec)")
title('LIF Output vs. Ground Truth');

ax = findall(gcf,'type','axes');
linkaxes(ax,'x');

